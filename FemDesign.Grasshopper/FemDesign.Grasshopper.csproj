  <!-- Rename the compiled assembly to a Grasshopper plug-in (.gha) and deploy it, plus its
       dependencies, to the local Grasshopper libraries folder. Replaces the legacy
       PostBuildEvent + AfterBuild pair; a single ordered target so the rename happens before
       the copy, and $(TargetPath)/$(TargetDir) expand reliably under both VS and `dotnet build`. -->
  <Target Name="DeployGrasshopperPlugin" AfterTargets="Build">
    <Move SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(TargetName).gha"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetPath)')" />
    <MakeDir Directories="$(appdata)\Grasshopper\Libraries\FemDesign\" />
    <ItemGroup>
      <Dlls Include="$(OutDir)FemDesign.*.dll" />
      <Ghas Include="$(OutDir)FemDesign.*.gha" />
      <Fuzzy Include="$(OutDir)FuzzySharp*.dll" />
      <CmdGlobalCfg Include="$(OutDir)Calculate\Config\cmdglobalcfg.xml" />
      <Cfg Include="$(OutDir)Calculate\Config\cfg.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(Dlls)" DestinationFolder="$(appdata)\Grasshopper\Libraries\FemDesign\" />
    <Copy SourceFiles="@(Ghas)" DestinationFolder="$(appdata)\Grasshopper\Libraries\FemDesign\" />
    <Copy SourceFiles="@(Fuzzy)" DestinationFolder="$(appdata)\Grasshopper\Libraries\FemDesign\" />
    <Copy SourceFiles="@(CmdGlobalCfg)" DestinationFolder="$(appdata)\Grasshopper\Libraries\FemDesign\" />
    <Copy SourceFiles="@(Cfg)" DestinationFolder="$(appdata)\Grasshopper\Libraries\FemDesign\" />
  </Target>

</Project>
